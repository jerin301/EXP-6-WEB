
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AI & Robotics Blog</title>

    <!-- CSS Styling -->
    <style>

        /* General Styling */
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #f4f4f4;
            color: #222;
            transition: background-color 1s;
        }

        /* Header */
        header {
            background-color: #172554;
            color: white;
            text-align: center;
            padding: 25px;
        }

        header h1 {
            margin-bottom: 10px;
        }

        /* Main Sections */
        main {
            padding: 20px;
        }

        .section {
            background-color: white;
            margin: 20px auto;
            padding: 20px;
            max-width: 900px;
            border-radius: 10px;
            box-shadow: 0 3px 8px #ccc;
        }

        .section h2 {
            color: #2563eb;
            border-bottom: 2px solid #eee;
            padding-bottom: 10px;
        }

        /* Digital Clock */
        #clock {
            color: #2563eb;
            font-size: 24px;
            font-weight: bold;
        }

        /* Buttons */
        button {
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 10px 16px;
            margin: 5px;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background-color: #172554;
        }

        /* Mouse Event */
        #aiMessage {
            font-size: 16px;
            transition: font-size 0.3s;
            cursor: pointer;
        }

        /* Robot Animation */
        #road {
            position: relative;
            width: 100%;
            height: 80px;
            background-color: #ddd;
            border-bottom: 5px dashed #555;
            overflow: hidden;
            margin: 15px 0;
        }

        #robot {
            position: absolute;
            left: 0;
            top: 15px;
            font-size: 35px;
        }

        /* Contributor Details */
        #contributorDetails p {
            line-height: 1.8;
        }

        /* Blog Cards */
        .blogs {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
        }

        .blog-card {
            background-color: #eff6ff;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 15px;
            flex: 1 1 200px;
            text-align: center;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .blog-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 12px #ccc;
        }

        .blog-card h3 {
            color: #2563eb;
        }

        /* Footer */
        footer {
            background-color: #172554;
            color: white;
            text-align: center;
            padding: 15px;
            margin-top: 20px;
        }

        /* Responsive Layout */
        @media (max-width: 600px) {
            main {
                padding: 10px;
            }

            .section {
                padding: 15px;
            }

            .blogs {
                flex-direction: column;
            }
        }

    </style>
</head>

<body>

    <!-- Header -->
    <header>
        <h1>🤖 AI & Robotics Blog</h1>
        <p>Explore Artificial Intelligence and Robotics Technology</p>
    </header>

    <main>

        <!-- Question 1: Digital Clock -->
        <section class="section">

            <h2>1. Digital Clock</h2>

            <p>
                Current Time:
                <span id="clock"></span>
            </p>

        </section>

        <!-- Question 2: Background Colour -->
        <section class="section">

            <h2>2. Dynamic Background</h2>

            <p>
                The background colour changes automatically.
            </p>

            <button id="backgroundBtn">
                Change Background Now
            </button>

        </section>

        <!-- Question 3: Mouse Events -->
        <section class="section">

            <h2>3. Interactive AI Message</h2>

            <p id="aiMessage">
                Move your mouse over this message to enlarge it!
            </p>

        </section>

        <!-- Question 4: Robot Animation -->
        <section class="section">

            <h2>4. Robot Animation</h2>

            <p>
                Click Move to start the animation and Stop to stop it.
            </p>

            <div id="road">
                <div id="robot">🤖</div>
            </div>

            <button id="moveBtn">Move</button>

            <button id="stopBtn">Stop</button>

        </section>

        <!-- Question 5: Array of Objects -->
        <section class="section">

            <h2>5. AI Blog Contributors</h2>

            <p>
                Contributor information and birth-year categories:
            </p>

            <div id="contributorDetails"></div>

        </section>

        <!-- AI Blog Cards -->
        <section class="section">

            <h2>Popular AI & Robotics Topics</h2>

            <div class="blogs">

                <div class="blog-card">

                    <h3>Artificial Intelligence</h3>

                    <p>
                        AI helps machines think and learn
                        like humans.
                    </p>

                </div>

                <div class="blog-card">

                    <h3>Machine Learning</h3>

                    <p>
                        Machine learning allows computers
                        to learn from data.
                    </p>

                </div>

                <div class="blog-card">

                    <h3>Robotics</h3>

                    <p>
                        Robots perform tasks automatically
                        using technology.
                    </p>

                </div>

            </div>

        </section>

    </main>

    <!-- Footer -->
    <footer>

        <p>
            © 2026 AI & Robotics Blog | Web Technology Lab
        </p>

    </footer>


    <!-- JavaScript -->
    <script>

        // Question 1: Display Digital Clock

        function displayClock() {

            let d = new Date();

            document.getElementById("clock").innerHTML =
                d.getHours() + ":" +
                String(d.getMinutes()).padStart(2, "0") + ":" +
                String(d.getSeconds()).padStart(2, "0");

        }

        displayClock();

        setInterval(displayClock, 1000);


        // Question 2: Change Background Colour

        function changeBackground() {

            let red = Math.floor(Math.random() * 256);

            let green = Math.floor(Math.random() * 256);

            let blue = Math.floor(Math.random() * 256);

            let color = "rgb(" + red + "," + green + "," + blue + ")";

            document.body.style.backgroundColor = color;

        }

        document.getElementById("backgroundBtn").onclick =
            changeBackground;

        setInterval(changeBackground, 30000);


        // Question 3: Increase and Decrease Font Size

        let message = document.getElementById("aiMessage");

        message.onmouseover = function() {

            message.style.fontSize = "28px";

        };

        message.onmouseout = function() {

            message.style.fontSize = "16px";

        };


        // Question 4: Move and Stop Robot Animation

        let robot = document.getElementById("robot");

        let position = 0;

        let animation;

        function moveRobot() {

            let road = document.getElementById("road");

            let maxPosition = road.clientWidth - robot.offsetWidth;

            if (position >= maxPosition) {

                position = 0;

            }

            position += 2;

            robot.style.left = position + "px";

        }

        document.getElementById("moveBtn").onclick = function() {

            if (!animation) {

                animation = setInterval(moveRobot, 20);

            }

        };

        document.getElementById("stopBtn").onclick = function() {

            clearInterval(animation);

            animation = null;

        };


        // Question 5: Array of Objects

        let contributors = [

            {
                name: "Jerin",
                regno: "URK24CS1281",
                year: 2001
            },

            {
                name: "Arun",
                regno: "UR24CS102",
                year: 1999
            },

            {
                name: "Priya",
                regno: "UR24CS103",
                year: 2003
            }

        ];

        let output = "";

        for (let i = 0; i < contributors.length; i++) {

            output +=
                "<p><b>Name:</b> " + contributors[i].name +

                "<br><b>Register Number:</b> " +
                contributors[i].regno +

                "<br><b>Birth Year:</b> " +
                contributors[i].year;

            if (contributors[i].year < 2000) {

                output +=
                    "<br>Category: Born before 2000";

            }

            else {

                output +=
                    "<br>Category: Born in or after 2000";

            }

            output += "</p><hr>";

        }

        document.getElementById("contributorDetails").innerHTML =
            output;

    </script>

</body>
</html>
